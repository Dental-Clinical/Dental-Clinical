# Copy to .env.development (or .env.<NODE_ENV>) and fill in.
# NODE_ENV is set by the npm scripts; plain `npm start` falls back to `.env`.

# --- Database -----------------------------------------------------------
# src/database/database.config.ts currently uses the discrete host/port form.
# Swap to the commented-out block there to use DB_URL instead.
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# Only read by the alternate (commented-out) DataSource in database.config.ts.
DB_URL=

# --- Auth ---------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_TOKEN_EXPIRES_IN=
JWT_TOKEN_AUDIENCE=
JWT_TOKEN_ISSUER=

# --- Redis (cache + OTP store) -----------------------------------------
REDIS_URL=
REDIS_TTL=

# --- WhatsApp (UltraMsg) ------------------------------------------------
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
ULTRAMSG_API_URL=

# --- Cloudinary ---------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Firebase / push notifications -------------------------------------
# From the service-account JSON. Leave blank to run with push disabled:
# the app still boots and logs a warning instead of failing at startup.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes; they are unescaped in src/config/firebase.config.ts.
FIREBASE_PRIVATE_KEY=
# Days a device token may go without re-registering before the nightly sweep
# removes it. Requires the client to re-register on every app launch. Default 60.
FCM_TOKEN_TTL_DAYS=

# --- Seeding (see src/database/seeds/README.md) -------------------------
SEED_RESET=
SEED_FORCE=
SEED_PASSWORD=

# --- Read by nothing in src/; present in .env.development as leftovers:
#   ENV_MODE, DB_TYPE, DB_SYNCHRONIZE, DB_SSL, AUTO_LOAD
# Note DB_SYNCHRONIZE is NOT wired up - synchronize is hardcoded to false in
# src/database/database.config.ts, so setting it here has no effect.
